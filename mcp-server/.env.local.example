# Copy to .env.local and fill in real values — .env.local is gitignored.
# Never commit this file or paste its values into chat/logs.

# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Dashboard -> Connect button (top right) -> connection string.
#
# In practice (confirmed 2026-08-28 against the real hrisph project): the
# "Direct connection" host (db.<project-ref>.supabase.co) is IPv6-only on
# the Free tier and simply won't resolve on most home/ISP networks (no IPv4
# add-on = no fallback). Use the **Session pooler** connection instead (port
# 5432, IPv4) — it's what actually worked here, NOT the "Transaction pooler"
# (port 6543), which doesn't guarantee the same backend connection across
# statements the way `SET LOCAL request.jwt.claims = ...` + an RPC call
# (both in one transaction, see src/db.ts) needs.
#
# The pooler host's node number is per-project, not derivable from the
# region alone — `aws-0-<region>` is the commonly-documented example, but
# this project's real host turned out to be `aws-1-ap-northeast-1`. Copy the
# exact string shown in the dashboard's Connect modal rather than guessing.
# Format: postgresql://postgres.<project-ref>:<password>@aws-<N>-<region>.pooler.supabase.com:5432/postgres
HRIS_DB_URL=

# The email of the HRISPH user this server acts as when calling org-scoped
# RPCs (deactivate_member, get_team_members, etc.). Must be a real user with
# an active org + role — looked up fresh on every call via user_profiles /
# user_roles, not cached here, so role/org changes are picked up automatically.
MCP_HRIS_ACTOR_EMAIL=

# Optional. Comma-separated organization ids. If set, every tool refuses to
# touch any org_id outside this list. Left unset by default — every org in
# the platform is reachable, per the 2026-08-28 design decision (see
# ../docs/mcp-server-design.md section 3.3). Set this later if you want to
# restrict a specific machine/session to one or a few orgs.
MCP_HRIS_ALLOWED_ORG_IDS=
